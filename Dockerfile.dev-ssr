# Development / staging image: same SSR runtime as production, but `development` Angular build (source maps, no prod env).
# Build:  docker build -f Dockerfile.dev-ssr -t duha-front-dev .
# Run:    docker run -p 8080:8080 -e PORT=8080 duha-front-dev
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install --force

COPY . .

# Firebase messaging service worker lives in public/ and is emitted to the web
# root by the Angular build, so no manual copy is required here.

RUN npx ng build --configuration development

ENV PORT=8080
EXPOSE 8080

CMD ["node", "dist/duha-dryfruits/server/server.mjs"]
