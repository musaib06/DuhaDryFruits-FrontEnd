{
  "name": "duha-dryfruits",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run serve:ssr",
    "start:dev": "ng serve --configuration development",
    "start:ssr:dev": "npm run build:dev && npm run serve:ssr",
    "start:ssr:localqa": "npm run build:localqa && npm run serve:ssr",
    "start:ssr:reg": "npm run build:reg && npm run serve:ssr",
    "start:localqa": "ng serve --configuration localqa",
    "start:reg": "ng serve --configuration reg",
    "start:prod": "npm run build:ssr && npm run serve:ssr",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "build:localqa": "ng build --configuration localqa",
    "build:reg": "ng build --configuration reg",
    "build:ssr": "ng build --configuration production",
    "build:prod": "npm run build:ssr",
    "serve:ssr": "node dist/duha-dryfruits/server/server.mjs",
    "start:server": "node server.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "postinstall": "patch-package"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.21",
    "@angular/compiler": "20.3.21",
    "@angular/core": "20.3.21",
    "@angular/forms": "20.3.21",
    "@angular/platform-browser": "20.3.21",
    "@angular/platform-server": "20.3.21",
    "@angular/router": "20.3.21",
    "@angular/service-worker": "20.3.21",
    "@angular/ssr": "20.3.21",
    "@auth0/angular-jwt": "^5.2.0",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@popperjs/core": "^2.11.8",
    "@types/jwt-decode": "^2.2.1",
    "axios": "^1.11.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^3.9.1",
    "crypto-js": "^4.2.0",
    "datatables.net": "^2.3.2",
    "datatables.net-bs5": "^2.3.2",
    "datatables.net-dt": "^2.3.2",
    "express": "^4.21.2",
    "idb": "^8.0.3",
    "jquery": "^3.7.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "ng2-charts": "^8.0.0",
    "ngx-quill": "^28.0.1",
    "ngx-ui-loader": "^19.0.0",
    "quill": "^2.0.3",
    "remixicon": "^4.9.1",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.22.2",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.21",
    "@angular/cli": "20.3.21",
    "@angular/compiler-cli": "20.3.21",
    "@types/crypto-js": "^4.2.2",
    "@types/datatables.net": "^1.10.28",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/jquery": "^3.5.32",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "patch-package": "^8.0.0",
    "typescript": "~5.8.2"
  }
}
